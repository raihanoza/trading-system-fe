# Contoh konfigurasi frontend. Salin ke `.env.production.local` (dipakai
# `next build`/`next start`) atau `.env.local`. JANGAN isi nilai rahasia di
# berkas ini — berkas ini masuk Git.

# Alamat backend API yang dihubungi SERVER frontend (proxy /api/backend).
# Browser tidak pernah memanggil alamat ini langsung.
TRADING_API_URL=http://127.0.0.1:4010

# Opsional. Harus sama dengan API_WRITE_TOKEN di .env backend bila backend
# mewajibkan token untuk POST/PUT/PATCH/DELETE. Hanya dibaca server frontend;
# tidak pernah masuk bundle browser, localStorage, atau respons API.
API_WRITE_TOKEN=

# Opsional. Batas waktu proxy ke backend (ms). Bawaan 900000 (15 menit) —
# scan crypto/overnight pernah >300 detik.
# TRADING_API_TIMEOUT_MS=900000

# Opsional. Hostname tambahan yang boleh membuka UI (bawaan: 127.0.0.1,
# localhost, ::1). Pagar terhadap DNS rebinding.
# FE_ALLOWED_HOSTS=

# Lama (masih dibaca sebagai cadangan TRADING_API_URL; tidak lagi dipakai browser).
# NEXT_PUBLIC_API_URL=http://localhost:4010
